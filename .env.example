# Local / application settings (no secret values)
APP_ENV=development
LOG_LEVEL=INFO

# Optional endpoints / non-secret config
API_ENDPOINT=

# Secrets — leave empty locally; copy to .env and fill values
# Do not commit real values. CI/CD uses GitHub Actions Secrets.
API_KEY=
TOKEN=
PASSWORD=

# Project integrations (GitHub Actions Secrets when used in CI)
DISCORD_TOKEN=
DISCORD_WEBHOOK_URL=
# Taxable Account Discord (Phase 8). Optional override; falls back to DISCORD_WEBHOOK_URL.
TAXABLE_DISCORD_WEBHOOK=
SOX_MOTOMOTO=
SOX_HYOKA=

# Optional channel IDs (may also be GitHub Actions Variables)
INPUT_CHANNEL_ID=
OUTPUT_CHANNEL_ID=
