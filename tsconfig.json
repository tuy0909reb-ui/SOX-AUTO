{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": ".",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node", "jest"]
  },
  "include": [
    "src/runtime_execution/**/*.ts",
    "src/orchestration/**/*.ts",
    "src/workflow/**/*.ts",
    "src/contracts/**/*.ts",
    "src/construction_selection/**/*.ts",
    "src/construction_selection_result/**/*.ts",
    "src/construction_plan/**/*.ts",
    "src/construction_planning_contract/**/*.ts",
    "src/construction_planning_definition/**/*.ts",
    "src/construction_planning_specification/**/*.ts",
    "src/construction_planning_manifest/**/*.ts",
    "src/construction_planning_consumption_boundary/**/*.ts",
    "src/construction_structural_responsibility_boundary/**/*.ts",
    "src/construction_responsibility_structural_interface_definition/**/*.ts",
    "src/construction_responsibility_structural_compatibility_validation/**/*.ts",
    "src/construction_responsibility_structural_normalization/**/*.ts",
    "src/extension_governance/**/*.ts",
    "src/extension_development_framework/**/*.ts",
    "src/extensions/asa_ops/**/*.ts",
    "src/extensions/asa_connect/**/*.ts",
    "src/extensions/asa_ai/**/*.ts",
    "src/extensions/asa_validation/**/*.ts",
    "src/extensions/asa_coordination/**/*.ts",
    "src/extensions/asa_scenario/**/*.ts",
    "src/architecture_evolution/**/*.ts",
    "src/architecture_validation/**/*.ts",
    "src/architecture_operations/**/*.ts",
    "src/architecture_extension/**/*.ts",
    "tests/architecture_extension/**/*.ts",
    "src/architecture_evolution_layer/**/*.ts",
    "tests/architecture_evolution_layer/**/*.ts",
    "src/architecture_intelligence/**/*.ts",
    "tests/architecture_intelligence/**/*.ts",
    "src/architecture_traceability/**/*.ts",
    "tests/architecture_traceability/**/*.ts",
    "src/architecture_recommendation/**/*.ts",
    "tests/architecture_recommendation/**/*.ts",
    "src/architecture_completion/**/*.ts",
    "tests/architecture_completion/**/*.ts",
    "tests/runtime_execution/**/*.ts",
    "tests/orchestration/**/*.ts",
    "tests/workflow/**/*.ts",
    "tests/contracts/**/*.ts",
    "tests/construction_selection/**/*.ts",
    "tests/construction_selection_result/**/*.ts",
    "tests/construction_plan/**/*.ts",
    "tests/construction_planning_contract/**/*.ts",
    "tests/construction_planning_definition/**/*.ts",
    "tests/construction_planning_specification/**/*.ts",
    "tests/construction_planning_manifest/**/*.ts",
    "tests/construction_planning_consumption_boundary/**/*.ts",
    "tests/construction_structural_responsibility_boundary/**/*.ts",
    "tests/construction_responsibility_structural_interface_definition/**/*.ts",
    "tests/construction_responsibility_structural_compatibility_validation/**/*.ts",
    "tests/construction_responsibility_structural_normalization/**/*.ts",
    "tests/extension_governance/**/*.ts",
    "tests/extension_development_framework/**/*.ts",
    "tests/extensions/asa_ops/**/*.ts",
    "tests/extensions/asa_connect/**/*.ts",
    "tests/extensions/asa_ai/**/*.ts",
    "tests/extensions/asa_validation/**/*.ts",
    "tests/extensions/asa_coordination/**/*.ts",
    "tests/extensions/asa_scenario/**/*.ts",
    "tests/architecture_evolution/**/*.ts",
